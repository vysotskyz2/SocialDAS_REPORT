# PostgreSQL
POSTGRES_HOST=reports-db
POSTGRES_PORT=5432
POSTGRES_DB=reports
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# MinIO
MINIO_ENDPOINT=reports-minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=reports
MINIO_SECURE=false

# Analytics Service
ANALYTICS_SERVICE_URL=http://analytics:8000/api/v1/analytics

# Report Settings
DOWNLOAD_URL_EXPIRY=3600
